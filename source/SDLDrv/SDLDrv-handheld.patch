 //
+// Handheld: centre UWindow's software cursor when a menu opens.
+// WindowConsole keeps the cursor in its MouseX/MouseY variables (GUI units, i.e.
+// pixels / Root.GUIScale) and only moves it by IK_MouseX/IK_MouseY deltas while
+// bWindowsMouseAvailable is 0. Without this, every menu would open with the
+// cursor wherever the previous one left it (the top-left corner the first time).
+// Called before each frame is drawn, so the first frame of a menu already has it.
+//
+static void CentreHandheldMenuMouse(USDLViewport* Viewport)
+{
+	static UBOOL MenuMouseCentred = 0; // the game has a single viewport
+
+	if (!Viewport->bShowWindowsMouse || !Viewport->Console)
+	{
+		MenuMouseCentred = 0;
+		return;
+	}
+	if (MenuMouseCentred)
+		return;
+
+	UObject*         Console  = Viewport->Console;
+	UFloatProperty*  MouseX   = FindField<UFloatProperty>(Console->GetClass(), TEXT("MouseX"));
+	UFloatProperty*  MouseY   = FindField<UFloatProperty>(Console->GetClass(), TEXT("MouseY"));
+	UObjectProperty* RootProp = FindField<UObjectProperty>(Console->GetClass(), TEXT("Root"));
+	if (!MouseX || !MouseY || !RootProp)
+	{
+		MenuMouseCentred = 1; // not a UWindow console
+		return;
+	}
+
+	// The root window (and with it GUIScale) is created by the first frame of
+	// the first menu; centre one frame later in that case.
+	UObject* Root = *(UObject**)((BYTE*)Console + RootProp->Offset);
+	if (!Root)
+		return;
+
+	UFloatProperty* ScaleProp = FindField<UFloatProperty>(Root->GetClass(), TEXT("GUIScale"));
+	FLOAT           GUIScale  = ScaleProp ? *(FLOAT*)((BYTE*)Root + ScaleProp->Offset) : 1.f;
+	if (GUIScale <= 0.f)
+		GUIScale = 1.f;
+
+	*(FLOAT*)((BYTE*)Console + MouseX->Offset) = Viewport->SizeX * 0.5f / GUIScale;
+	*(FLOAT*)((BYTE*)Console + MouseY->Offset) = Viewport->SizeY * 0.5f / GUIScale;
+	MenuMouseCentred                           = 1;
+
+	debugf(
+		NAME_Init,
+		TEXT("SDLDrv: Handheld - menu opened, centred the UWindow cursor at %.0f,%.0f (GUIScale %.2f)"),
+		Viewport->SizeX * 0.5f / GUIScale,
+		Viewport->SizeY * 0.5f / GUIScale,
+		GUIScale);
+}
