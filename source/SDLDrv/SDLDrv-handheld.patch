 void USDLViewport::Repaint(UBOOL Blit)
 {
 	guard(USDLViewport::Repaint);
+	if (GSDLDrvHandheld)
+		CentreHandheldMenuMouse(this);
 	GetOuterUSDLClient()->Engine->Draw(this, Blit);
 	RepaintPending = FALSE;
 	unguard;
