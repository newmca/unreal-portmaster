+void UNOpenGLESRenderDevice::SetTexture( INT TMU, FTextureInfo& Info, DWORD PolyFlags, FLOAT PanBias )
+{
+	guard(UNOpenGLESRenderDevice::SetTexture);
+
+	CurrentShaderFlags |= 1 << TMU;
+
+	// Set panning.
+	FTexInfo& Tex = TexInfo[TMU];
+	Tex.UPan      = Info.Pan.X + PanBias*Info.UScale;
+	Tex.VPan      = Info.Pan.Y + PanBias*Info.VScale;
+
+	// Account for all the impact on scale normalization.
+	Tex.UMult = 1.f / (Info.UScale * static_cast<FLOAT>(Info.USize));
+	Tex.VMult = 1.f / (Info.VScale * static_cast<FLOAT>(Info.VSize));
+
+	// Find in cache. P8 textures upload differently for masked (index 0
+	// transparent) and alpha-blended (palette alpha) drawing.
+	QWORD NewCacheID = Info.CacheID;
+	if( Info.Format == TEXF_P8 )
+	{
+		if( PolyFlags & PF_Masked )
+			NewCacheID |= MASKED_TEXTURE_TAG;
+		if( PolyFlags & PF_AlphaBlend )
+			NewCacheID |= ALPHABLEND_TEXTURE_TAG;
+	}
+	FCachedTexture* Bind = BindMap.Find( NewCacheID );
+
+	// Realtime textures (fire, water, scripted) flag bRealtimeChanged; 227
+	// replaced the per-device bookkeeping with RenderTag, which changes
+	// whenever the texels do (as XOpenGLDrv checks it).
+	const UBOOL Stale = Bind && Info.bRealtimeChanged && Info.RenderTag != Bind->RenderTag;
+	if( Bind && NewCacheID == Tex.CurrentCacheID && !Stale )
+		return;
+
+	FlushTriangles();
+
+	// Make current.
+	Tex.CurrentCacheID = NewCacheID;
+	const UBOOL NewTexture = !Bind;
+	if( !Bind )
+	{
+		FCachedTexture NewBind;
+		appMemzero( &NewBind, sizeof(NewBind) );
+		Bind = &BindMap.Set( NewCacheID, NewBind );
+		glGenTextures( 1, &Bind->Id );
+		TexAlloc.AddItem( Bind->Id );
+	}
+
+	glActiveTexture( GL_TEXTURE0 + TMU );
+	glBindTexture( GL_TEXTURE_2D, Bind->Id );
+
+	if( NewTexture || Stale )
+	{
+		Bind->RenderTag = Info.RenderTag;
+		Info.bRealtimeChanged = 0;
+		// Light maps and fog map alpha have tone tables of their own;
+		// DrawComplexSurface binds light maps to unit 1 and fog maps to unit 2.
+		const BYTE Tone = !IsLightOrFogMap( Info ) ? TONE_Texture : ( TMU == 2 ) ? TONE_FogMap : TONE_LightMap;
+		if( !UploadTexture( Info, *Bind, PolyFlags, NewTexture, Tone ) )
+			UploadFallbackTexture( Info, *Bind, NewTexture );
+		// TODO: This depends on PolyFlags, not Info.
+		UpdateTextureFilter( Info, *Bind, PolyFlags );
+	}
+
+	unguard;
+}
+
+void UNOpenGLESRenderDevice::UpdateTextureFilter( const FTextureInfo& Info, const FCachedTexture& Bind, DWORD PolyFlags )
+{
+	guard(UNOpenGLESRenderDevice::UpdateTextureFilter);
+
+	// Mip filtering only if UploadTexture left a complete chain.
+	const UBOOL HasMips = Bind.MaxLevel > 0;
+	const UBOOL LightOrFogMap = IsLightOrFogMap( Info );
+	if( ( PolyFlags & PF_NoSmooth ) || ( NoFiltering && !LightOrFogMap ) )
+	{
+		glTexParameteri( GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, HasMips ? GL_NEAREST_MIPMAP_NEAREST : GL_NEAREST );
+		glTexParameteri( GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST );
+	}
+	else
+	{
+		glTexParameteri( GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, HasMips ? GL_LINEAR_MIPMAP_LINEAR : GL_LINEAR );
+		glTexParameteri( GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR );
+	}
+
+	// Light and fog maps, and textures with a 227 UClamp/VClamp mode, do not
+	// repeat. Upstream told light maps apart by their missing palette, which
+	// would also clamp every BC and RGBA texture here.
+	glTexParameteri( GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, ( LightOrFogMap || Info.UClampMode == UClamp ) ? GL_CLAMP_TO_EDGE : GL_REPEAT );
+	glTexParameteri( GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, ( LightOrFogMap || Info.VClampMode == VClamp ) ? GL_CLAMP_TO_EDGE : GL_REPEAT );
+
+	unguard;
+}
+
+void UNOpenGLESRenderDevice::EnsureComposeSize( DWORD Size )
+{
+	guard(UNOpenGLESRenderDevice::EnsureComposeSize);
+	if( Size > ComposeSize )
+	{
+		// Upstream did not record the new size, so it reallocated on nearly every upload (UE1 99319bb).
+		Compose = (BYTE*)appRealloc( Compose, Size, TEXT("GLComposeBuf") );
+		verify( Compose );
+		ComposeSize = Size;
+	}
+	unguard;
+}
+
+void UNOpenGLESRenderDevice::UploadLevel( INT Level, INT USize, INT VSize, GLenum Format, const void* Data, UBOOL NewTexture )
+{
+	if( NewTexture )
+		glTexImage2D( GL_TEXTURE_2D, Level, Format, USize, VSize, 0, Format, GL_UNSIGNED_BYTE, Data );
+	else
+		glTexSubImage2D( GL_TEXTURE_2D, Level, 0, 0, USize, VSize, Format, GL_UNSIGNED_BYTE, Data );
+}
+
+//
+// GLES2 has no GL_TEXTURE_MAX_LEVEL: a mipmapped texture must have every
+// level down to 1x1, or it samples as black. Stored chains may stop early
+// (BC mips often end at 4x4) or lose a level to missing data; the missing
+// levels are box-filtered from the last uploaded one. Data is that level
+// (USize x VSize, 4 bytes per texel). Returns the last level.
+//
+INT UNOpenGLESRenderDevice::CompleteMipChain( INT Level, INT USize, INT VSize, const BYTE* Data, GLenum Format, UBOOL NewTexture )
+{
+	guard(UNOpenGLESRenderDevice::CompleteMipChain);
+
+	while( USize > 1 || VSize > 1 )
+	{
+		// Compose may be Data: the downsampler works in place.
+		BCDecode::DownsampleRGBA8( Data, USize, VSize, Compose );
+		USize = BCDecode::HalfSize( USize );
+		VSize = BCDecode::HalfSize( VSize );
+		Data = Compose;
+		UploadLevel( ++Level, USize, VSize, Format, Data, NewTexture );
+	}
+	return Level;
+
+	unguard;
+}
