+	static const GLenum DepthFuncs[ZTEST_MAX] = { GL_LESS, GL_EQUAL, GL_LEQUAL, GL_GREATER, GL_GEQUAL, GL_NOTEQUAL, GL_ALWAYS };
+	const BYTE Previous = CurrentZTestMode;
+	if( Mode < ZTEST_MAX && Mode != CurrentZTestMode )
+	{
+		FlushTriangles();
+		glDepthFunc( DepthFuncs[Mode] );
+		CurrentZTestMode = Mode;
+	}
+	return Previous;
+
+	unguard;
+}
