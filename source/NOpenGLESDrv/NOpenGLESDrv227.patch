+
+	GLenum UploadFormat = GL_RGBA;
+	INT Level = -1;
+	INT USize = 0, VSize = 0;
+	const BYTE* LevelData = NULL;
+
+	BCDecode::EFormat BCFormat = BCDecode::FORMAT_BC1;
+	UBOOL IsBC = 1;
+	switch( Info.Format )
+	{
+		case TEXF_BC1: BCFormat = BCDecode::FORMAT_BC1; break;
+		case TEXF_BC2: BCFormat = BCDecode::FORMAT_BC2; break;
+		case TEXF_BC3: BCFormat = BCDecode::FORMAT_BC3; break;
+		default:       IsBC = 0; break;
+	}
+
+	if( IsBC )
+	{
+		// Decode the largest mip within MaxDecompressedTextureSize (and the GL
+		// limit); a texture without such a mip is decoded at its smallest one
+		// and halved on the CPU. Mips without data are skipped, as in
+		// OpenGLDrv's GetBaseMip.
+		uint32_t Widths[MAX_MIPS], Heights[MAX_MIPS];
+		for( INT i = 0; i < NumMips; i++ )
+		{
+			const FMipmapBase* Mip = Info.Mips[i];
+			const UBOOL Usable = Mip && Mip->DataPtr && Mip->USize > 0 && Mip->VSize > 0;
+			Widths[i]  = Usable ? Mip->USize : 0;
+			Heights[i] = Usable ? Mip->VSize : 0;
+		}
+		uint32_t Cap = MaxTextureSize;
+		if( MaxDecompressedTextureSize > 0 && (uint32_t)MaxDecompressedTextureSize < Cap )
+			Cap = MaxDecompressedTextureSize;
+		const BCDecode::MipSelection Sel = BCDecode::SelectBaseMip( Widths, Heights, NumMips, Cap );
+		if( Sel.BaseMip < 0 )
+			return 0;
+		Bind.BaseMip = Sel.BaseMip;
+
+		for( INT i = Sel.BaseMip; i < NumMips; i++ )
+		{
+			const FMipmapBase* Mip = Info.Mips[i];
+			// Further stored mips must continue the chain; a texture halved on
+			// the CPU has none (its base was the smallest usable one).
+			if( Level >= 0 && ( Sel.ExtraHalvings || !Widths[i]
+				|| Mip->USize != (INT)BCDecode::HalfSize( USize ) || Mip->VSize != (INT)BCDecode::HalfSize( VSize ) ) )
+				break;
+			const size_t Needed = BCDecode::CompressedBytes( BCFormat, Mip->USize, Mip->VSize );
+			EnsureComposeSize( BCDecode::RGBA8Bytes( Mip->USize, Mip->VSize ) );
+			if( !BCDecode::Decode( BCFormat, Mip->DataPtr, MipDataBytes( Info, i, Needed ), Mip->USize, Mip->VSize, Compose ) )
+			{
+				if( Level < 0 )
+				{
+					debugf( NAME_Warning, TEXT("NOpenGLESDrv: %ls mip %i (%ix%i) has too little data"),
+						Info.Texture ? Info.Texture->GetPathName() : TEXT("(none)"), i, Mip->USize, Mip->VSize );
+					return 0;
+				}
+				break;
+			}
+			USize = Mip->USize;
+			VSize = Mip->VSize;
+			for( uint32_t Halving = 0; Level < 0 && Halving < Sel.ExtraHalvings; Halving++ )
+			{
+				BCDecode::DownsampleRGBA8( Compose, USize, VSize, Compose );
+				USize = BCDecode::HalfSize( USize );
+				VSize = BCDecode::HalfSize( VSize );
+			}
+			if( !ToneIdentity )
+				ToneRGBA( Compose, Compose, USize * VSize, 0, TONE_Texture );
+			LevelData = Compose;
+			if( Level < 0 )
+				NewTexture |= StartLevel0( Bind, WasFallback, USize, VSize );
+			UploadLevel( ++Level, USize, VSize, GL_RGBA, LevelData, NewTexture );
+		}
+	}
+	else
+	{
+		const BYTE Format = Info.Format;
+		if( Format != TEXF_P8 && Format != TEXF_BGRA8_LM && Format != TEXF_BGRA8 && Format != TEXF_RGBA8_ )
+		{
+			// Report each format once; a map full of them would flood the log.
+			if( !( WarnedFormats[Format >> 5] & ( 1u << ( Format & 31 ) ) ) )
+			{
+				WarnedFormats[Format >> 5] |= 1u << ( Format & 31 );
+				debugf( NAME_Warning, TEXT("NOpenGLESDrv: texture format %ls is not supported (first seen on %ls); drawing grey"),
+					*FTextureFormatString( Format ), Info.Texture ? Info.Texture->GetPathName() : TEXT("(none)") );
+			}
+			return 0;
+		}
+		if( Format == TEXF_P8 && !Info.Palette )
+			return 0;
+
+		// Largest mip with data within the GL limit.
+		INT BaseMip = 0;
+		while( BaseMip < NumMips && ( !Info.Mips[BaseMip] || !Info.Mips[BaseMip]->DataPtr
+			|| Info.Mips[BaseMip]->USize > MaxTextureSize || Info.Mips[BaseMip]->VSize > MaxTextureSize ) )
+			BaseMip++;
+		if( BaseMip >= NumMips )
+			return 0;
+		Bind.BaseMip = BaseMip;
+		EnsureComposeSize( Info.Mips[BaseMip]->USize * Info.Mips[BaseMip]->VSize * 4 );
+
+		// The palette through the tone table. Its alpha is mostly garbage in
+		// old packages, so it is forced opaque, except for alpha-blended
+		// drawing (227 content that relies on it).
+		DWORD TonePal[256];
+		if( Format == TEXF_P8 )
+		{
+			const UBOOL KeepAlpha = ( PolyFlags & PF_AlphaBlend ) != 0;
+			const BYTE* Src = (const BYTE*)Info.Palette; // FColor: R, G, B, A in memory.
+			BYTE* Dst = (BYTE*)TonePal;
+			for( INT i = 0; i < 256; i++, Src += 4, Dst += 4 )
+			{
+				Dst[0] = ToneLUT[Src[0]];
+				Dst[1] = ToneLUT[Src[1]];
+				Dst[2] = ToneLUT[Src[2]];
+				Dst[3] = KeepAlpha ? Src[3] : 255;
+			}
+		}
+		// Uploaded straight from the mip data when nothing changes.
+		const UBOOL AsIs = ToneIdentity && Tone == TONE_Texture && ( Format == TEXF_RGBA8_ || ( UseBGRA && Format != TEXF_P8 ) );
+		if( AsIs )
+			UploadFormat = ( Format == TEXF_RGBA8_ ) ? GL_RGBA : GL_BGRA_EXT;
+
+		for( INT i = BaseMip; i < NumMips; i++ )
+		{
+			const FMipmapBase* Mip = Info.Mips[i];
+			if( !Mip || !Mip->DataPtr || Mip->USize <= 0 || Mip->VSize <= 0 )
+				break;
+			if( Level >= 0 && ( Mip->USize != (INT)BCDecode::HalfSize( USize ) || Mip->VSize != (INT)BCDecode::HalfSize( VSize ) ) )
+				break;
+			const DWORD Count = Mip->USize * Mip->VSize;
+			if( Format == TEXF_P8 )
+			{
+				// 8-bit indexed. Masked: index 0 is transparent.
+				const BYTE* Src = Mip->DataPtr;
+				DWORD* Dst = (DWORD*)Compose;
+				if( PolyFlags & PF_Masked )
+					for( DWORD j = 0; j < Count; j++ )
+						Dst[j] = Src[j] ? TonePal[Src[j]] : 0;
+				else
+					for( DWORD j = 0; j < Count; j++ )
+						Dst[j] = TonePal[Src[j]];
+				LevelData = Compose;
+			}
+			else if( AsIs )
+			{
+				// Already in the upload format.
+				LevelData = Mip->DataPtr;
+			}
+			else
+			{
+				// RGBA8_ as it is, BGRA8 and BGRA8_LM with red and blue swapped.
+				ToneRGBA( Mip->DataPtr, Compose, Count, Format != TEXF_RGBA8_, Tone );
+				LevelData = Compose;
+			}
+			USize = Mip->USize;
+			VSize = Mip->VSize;
+			if( Level < 0 )
+				NewTexture |= StartLevel0( Bind, WasFallback, USize, VSize );
+			UploadLevel( ++Level, USize, VSize, UploadFormat, LevelData, NewTexture );
+		}
+	}
+
+	// A chain of two or more levels is completed down to 1x1 and mip filtered;
+	// a single level (light maps, mipless textures) is not.
+	if( Level > 0 )
+		Level = CompleteMipChain( Level, USize, VSize, LevelData, UploadFormat, NewTexture );
+	Bind.MaxLevel = Level;
+	return Level >= 0;
+
+	unguard;
+}
+
+//
+// Neutral texture for formats and data this device cannot use: mid grey,
+// which also leaves modulated surfaces unchanged.
+//
+void UNOpenGLESRenderDevice::UploadFallbackTexture( FTextureInfo& Info, FCachedTexture& Bind, UBOOL NewTexture )
+{
+	guard(UNOpenGLESRenderDevice::UploadFallbackTexture);
+
+	BYTE Grey[8 * 8 * 4];
+	for( INT i = 0; i < 8 * 8 * 4; i++ )
+		Grey[i] = ( i & 3 ) == 3 ? 255 : ToneLUT[0x80];
+	// Always a new image: whatever was there before may have another size.
+	UploadLevel( 0, 8, 8, GL_RGBA, Grey, 1 );
+	Bind.BaseMip = INDEX_NONE;
+	Bind.MaxLevel = 0;
+	Bind.USize = Bind.VSize = 8;
+
+	unguard;
+}
+
+#endif // NOPENGLES_227
