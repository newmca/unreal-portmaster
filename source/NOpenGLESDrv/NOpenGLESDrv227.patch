+
+	debugf( NAME_Log, TEXT("NOpenGLESDrv: Brightness %.2f: x^%.3f, scale %.4f + %.4f t + %.4f t^2"),
+		Brightness, ToneGamma, ToneScale, ToneBoost[0], ToneBoost[1] );
