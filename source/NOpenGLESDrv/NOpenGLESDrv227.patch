+//
+// Converts a rectangle in viewport pixels (origin top left, SizeX x SizeY)
+// to the GL viewport. The default framebuffer has the window's physical
+// size, which SDLDrv may report as different from SizeX x SizeY (hi-dpi,
+// or a fullscreen window larger than the requested mode); the engine's
+// image is then stretched to it, as XOpenGLDrv's framebuffer blit does.
+//
+void UNOpenGLESRenderDevice::SetGLViewport( INT X, INT Y, INT XL, INT YL )
+{
+	const INT SizeX = Max<INT>( Viewport->SizeX, 1 );
+	const INT SizeY = Max<INT>( Viewport->SizeY, 1 );
+	const INT PhysX = Viewport->PhysicalSizeX > 0 ? Viewport->PhysicalSizeX : SizeX;
+	const INT PhysY = Viewport->PhysicalSizeY > 0 ? Viewport->PhysicalSizeY : SizeY;
+	const INT X0 = X * PhysX / SizeX;
+	const INT X1 = ( X + XL ) * PhysX / SizeX;
+	const INT Y0 = ( SizeY - Y - YL ) * PhysY / SizeY;
+	const INT Y1 = ( SizeY - Y ) * PhysY / SizeY;
+	glViewport( X0, Y0, Max<INT>( X1 - X0, 1 ), Max<INT>( Y1 - Y0, 1 ) );
+}
