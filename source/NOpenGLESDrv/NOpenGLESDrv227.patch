+#ifdef NOPENGLES_TONE
+// x^gamma for x in [0,1] as a polynomial (UpdateTone), no pow.
+uniform mediump vec3 uTonePow;
+#define TONE_POW(X) ((X) + (X) * (1.0 - (X)) * (uTonePow.x + (X) * (uTonePow.y + (X) * uTonePow.z)))
+#endif
+#endif
 
