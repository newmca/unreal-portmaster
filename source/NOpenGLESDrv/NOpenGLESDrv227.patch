+//
+// Least-squares fit of Residual(x) ~ C0 * Row0(x) + C1 * Row1(x) + C2 * Row2(x)
+// over x = i/255, i = 1..255, Terms(x, Row, Residual) giving the values: the
+// normal equations, solved by Gauss-Jordan elimination (symmetric positive
+// definite, so no pivoting is needed). Used by UpdateTone.
+//
+template<typename FTerms> static void FitTone( FTerms Terms, DOUBLE C[3] )
+{
+	DOUBLE M[3][4] = {};
+	for( INT i = 1; i <= 255; i++ )
+	{
+		DOUBLE Row[3], Residual;
+		Terms( i / 255.0, Row, Residual );
+		for( INT r = 0; r < 3; r++ )
+		{
+			for( INT c = 0; c < 3; c++ )
+				M[r][c] += Row[r] * Row[c];
+			M[r][3] += Row[r] * Residual;
+		}
+	}
+	for( INT p = 0; p < 3; p++ )
+		for( INT r = 0; r < 3; r++ )
+			if( r != p )
+			{
+				const DOUBLE F = M[r][p] / M[p][p];
+				for( INT c = p; c < 4; c++ )
+					M[r][c] -= F * M[p][c];
+			}
+	for( INT r = 0; r < 3; r++ )
+		C[r] = M[r][3] / M[r][r];
