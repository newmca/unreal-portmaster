+static void UT99PortMasterSyncMenuMouse469( UViewport* Viewport )
+{
+	if( !Viewport || !Viewport->GetWindow() )
+		return;
+
+	SDL_Window* Window = (SDL_Window*)Viewport->GetWindow();
+	INT WindowW = 0;
+	INT WindowH = 0;
+	INT DrawableW = 0;
+	INT DrawableH = 0;
+	SDL_GetWindowSize( Window, &WindowW, &WindowH );
+	SDL_GL_GetDrawableSize( Window, &DrawableW, &DrawableH );
+	if( WindowW <= 0 || WindowH <= 0 || DrawableW <= 0 || DrawableH <= 0 )
+		return;
+
+	USDLViewport* SDLViewport = static_cast<USDLViewport*>( Viewport );
+	UBOOL ShowMenuMouse = Viewport->bShowWindowsMouse ? 1 : 0;
+	const TCHAR* ConsoleStateName = TEXT("<none>");
+	if( Viewport->Console )
+	{
+		FStateFrame* ConsoleState = Viewport->Console->GetStateFrame();
+		if( ConsoleState && ConsoleState->StateNode )
+		{
+			ConsoleStateName = ConsoleState->StateNode->GetName();
+			static FName NAME_UT99PortMasterUWindow( TEXT("UWindow") );
+			ShowMenuMouse |= ConsoleState->StateNode->GetFName() == NAME_UT99PortMasterUWindow;
+		}
+	}
+	static UBOOL WasShowingMenuMouse = 0;
+	static UObject* CenteredRoot = NULL;
+	FLOAT GUIScale = 1.f;
+	const char* GUIScaleEnv = SDL_getenv( "UT99_GUI_SCALE" );
+	if( GUIScaleEnv )
+		GUIScale = Max<FLOAT>( (FLOAT)std::atof(GUIScaleEnv), 1.f );
+	const FLOAT CenterX = Viewport->SizeX / (2.f * GUIScale);
+	const FLOAT CenterY = Viewport->SizeY / (2.f * GUIScale);
+	UObject* Root = UT99PortMasterFindObjectProperty469( Viewport->Console, TEXT("Root") );
+
+	if( ShowMenuMouse )
+	{
+		// UWindow requests the operating-system cursor each frame. PortMaster's
+		// controller mouse is relative, so immediately restore relative capture
+		// and hide SDL's cursor if the engine released or exposed either one.
+		// This also prevents SDL from switching to its bounded absolute position
+		// after gameplay, which caused the cursor to need edge "recalibration".
+		Viewport->bWindowsMouseAvailable = 0;
+		if( !SDLViewport->MouseIsGrabbed || SDL_GetRelativeMouseMode() != SDL_TRUE )
+			SDLViewport->UpdateMouseGrabState( 1 );
+		SDL_ShowCursor( SDL_DISABLE );
+		SDL_SetWindowGrab( Window, SDL_TRUE );
+
+		if( !WasShowingMenuMouse || (Root && Root != CenteredRoot) )
+		{
+			UT99PortMasterSetFloatProperty469( Viewport->Console, TEXT("MouseX"), CenterX );
+			UT99PortMasterSetFloatProperty469( Viewport->Console, TEXT("MouseY"), CenterY );
+			UT99PortMasterSetFloatProperty469( Root, TEXT("MouseX"), CenterX );
+			UT99PortMasterSetFloatProperty469( Root, TEXT("MouseY"), CenterY );
+			UT99PortMasterSetFloatProperty469( Root, TEXT("OldMouseX"), CenterX );
+			UT99PortMasterSetFloatProperty469( Root, TEXT("OldMouseY"), CenterY );
+			Viewport->WindowsMouseX = Viewport->SizeX * 0.5f;
+			Viewport->WindowsMouseY = Viewport->SizeY * 0.5f;
+			INT DiscardX = 0;
+			INT DiscardY = 0;
+			SDL_GetRelativeMouseState( &DiscardX, &DiscardY );
+			CenteredRoot = Root;
+			std::fprintf( stderr,
+				"UT99_SOFTWARE_MENU_CURSOR scale=%.2f center=%.1f,%.1f root=%d discarded=%d,%d\n",
+				GUIScale, CenterX, CenterY, Root ? 1 : 0, DiscardX, DiscardY );
+			std::fflush( stderr );
+		}
+	}
+
+	if( ShowMenuMouse != WasShowingMenuMouse )
+	{
+		if( !ShowMenuMouse )
+		{
+			Viewport->bWindowsMouseAvailable = 1;
+			SDLViewport->UpdateMouseGrabState( 1 );
+			CenteredRoot = NULL;
+		}
+		std::fprintf( stderr,
+			"UT99_MOUSE_CAPTURE menu=%d state=%s grabbed=%d cursor=%.1f,%.1f\n",
+			ShowMenuMouse, appToAnsi(ConsoleStateName), SDLViewport->MouseIsGrabbed ? 1 : 0,
+			Viewport->WindowsMouseX, Viewport->WindowsMouseY );
+		std::fflush( stderr );
+		WasShowingMenuMouse = ShowMenuMouse;
+	}
+
+	static INT LastWindowW = -1;
+	static INT LastWindowH = -1;
+	static INT LastDrawableW = -1;
+	static INT LastDrawableH = -1;
+	static INT LastViewportW = -1;
+	static INT LastViewportH = -1;
+	if( WindowW != LastWindowW || WindowH != LastWindowH ||
+		DrawableW != LastDrawableW || DrawableH != LastDrawableH ||
+		Viewport->SizeX != LastViewportW || Viewport->SizeY != LastViewportH )
+	{
+		std::fprintf( stderr,
+			"UT99_COORDS point=%dx%d drawable=%dx%d viewport=%dx%d mouseScale=%.3fx%.3f menu=%d state=%s grabbed=%d windowsMouse=%d cursor=%.1f,%.1f\n",
+			WindowW, WindowH, DrawableW, DrawableH, Viewport->SizeX, Viewport->SizeY,
+			SDLViewport->MouseScaleX, SDLViewport->MouseScaleY,
+			ShowMenuMouse, appToAnsi(ConsoleStateName),
+			SDLViewport->MouseIsGrabbed ? 1 : 0,
+			Viewport->bWindowsMouseAvailable ? 1 : 0,
+			Viewport->WindowsMouseX, Viewport->WindowsMouseY );
+		std::fflush( stderr );
+		LastWindowW = WindowW;
+		LastWindowH = WindowH;
+		LastDrawableW = DrawableW;
+		LastDrawableH = DrawableH;
+		LastViewportW = Viewport->SizeX;
+		LastViewportH = Viewport->SizeY;
