+//
+// 227 zone distance fog (ZoneInfo.bDistanceFog). Render calls PreDrawGouraud
+// before and PostDrawGouraud after the geometry of a fogged zone; everything
+// drawn in between blends towards the fog colour by eye depth (SF_DistanceFog,
+// FragmentShader.glsl.inc), with OpenGLDrv's linear/exp/exp2 formulas.
+//
+void UNOpenGLESRenderDevice::PreDrawGouraud( FSceneNode* Frame, FFogSurf& FogSurf )
+{
+	guard(UNOpenGLESRenderDevice::PreDrawGouraud);
+
+	// As OpenGLDrv: decals and projectors are drawn without distance fog (the
+	// state of the surface below them is left as it is, see PostDrawGouraud).
+	if( GUglyHackFlags & HACKFLAGS_DrawingDecal )
+		return;
+
+	if( !FogSurf.IsValid() )
+	{
+		PostDrawGouraud( Frame, FogSurf );
+		return;
+	}
+
+	// Fog must not tint the framebuffer through blended polygons: modulated
+	// ones fade to the neutral mid grey, translucent (additive) ones to black.
+	FPlane Color = FogSurf.FogColor;
+	if( FogSurf.PolyFlags & PF_Modulated )
+		Color = FPlane( 0.5f, 0.5f, 0.5f, 1.f );
+	else if( FogSurf.PolyFlags & PF_Translucent )
+		Color = FPlane( 0.f, 0.f, 0.f, 1.f );
+	else
+		Color.W = 1.f;
+	// Mixed in before the final scale, like a texel (mid grey becomes the
+	// modulated draws' neutral (0.5)^gamma).
+	Color = ToneColor( Color );
+
+	// Fog amount from the eye depth D: linear clamp(D*X+Y), exponential
+	// 1-exp(-D*X), exponential squared 1-exp(-(D*X)^2); Z selects the formula.
+	FPlane Params( 0.f, 0.f, 0.f, 0.f );
+	if( FogSurf.FogMode == 0 )
+	{
+		const FLOAT Range = Max<FLOAT>( FogSurf.FogDistanceEnd - FogSurf.FogDistanceStart, 1.f );
+		Params = FPlane( 1.f / Range, -FogSurf.FogDistanceStart / Range, 0.f, 0.f );
+	}
+	else
+		Params = FPlane( FogSurf.FogDensity, 0.f, FogSurf.FogMode == 1 ? 1.f : 2.f, 0.f );
+
+	if( !DistanceFogActive || Color != DistanceFogColor || Params != DistanceFogParams )
+	{
+		FlushTriangles();
+		DistanceFogActive = 1;
+		DistanceFogColor = Color;
+		DistanceFogParams = Params;
+		UniformsChanged[UF_DistanceFogColor] = UniformsChanged[UF_DistanceFogParams] = true;
+	}
+
+	unguard;
+}
+
+void UNOpenGLESRenderDevice::PostDrawGouraud( FSceneNode* Frame, FFogSurf& FogSurf )
+{
+	guard(UNOpenGLESRenderDevice::PostDrawGouraud);
+
+	if( GUglyHackFlags & HACKFLAGS_DrawingDecal )
+		return;
+
+	if( DistanceFogActive )
+	{
+		FlushTriangles();
+		DistanceFogActive = 0;
+	}
+
+	unguard;
+}
