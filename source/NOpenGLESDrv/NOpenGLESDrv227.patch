+#ifdef NOPENGLES_TONE
+// 227: textures, light/fog maps and colours arrive with the tone curve's
+// power applied (UNOpenGLESRenderDevice::UpdateTone). X: final colour scale,
+// Y: light map scale (2*overbright)^gamma, Z: 2^gamma for the fog maps and
+// detail textures, which are stored at half intensity, W: 2 - 2^gamma.
+uniform mediump vec4 uToneScale;
+#define LIGHTMAP_SCALE uToneScale.y
+#define HALF_SCALE uToneScale.z
+#ifdef SF_ToneBoost
+// Brightness above 0.5: the final scale is uToneScale.x + t * X + t^2 * Y,
+// t being the brightest channel (OpenGLDrv's brightness boost).
+uniform mediump vec2 uToneBoost;
+#endif
+// Fog adds F to the attenuated colour C, and the tone power of the sum is
+// wanted from the powers of both: C^g + F^g - (2 - 2^g) * min(C^g, F^g)
+// is exact when either is zero or both are equal, and at most 5% too
+// bright in between at g = 0.8 (the plain sum would be up to 13% too bright).
+#define FOG_ADD(C, F) ((C) + (F) - uToneScale.w * min((C), (F)))
+#else
 uniform lowp float uBrightness;
+#ifndef LIGHTMAP_OVERBRIGHT
+#define LIGHTMAP_OVERBRIGHT 1.0
+#endif
+#define LIGHTMAP_SCALE (2.0 * LIGHTMAP_OVERBRIGHT)
+#define HALF_SCALE 2.0
+#endif
