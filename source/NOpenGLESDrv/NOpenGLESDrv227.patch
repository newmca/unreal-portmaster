+	{
+		const BYTE SR = Src[R], SG = Src[1], SB = Src[B], SA = Src[3];
+		Dst[0] = LUT[SR];
+		Dst[1] = LUT[SG];
+		Dst[2] = LUT[SB];
+		Dst[3] = FogMap ? ToneFogAlphaLUT[SA] : SA;
+	}
