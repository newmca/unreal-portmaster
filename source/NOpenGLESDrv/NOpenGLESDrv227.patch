+//
+// Tone curve. The stock OpenGLDrv (227k_15: OpenGL.cpp Lock,
+// OpenGLBase.cpp SetColorCorrection, OpenGL_ShaderWriter.h; UseShaderGamma
+// off, as the port configures it) maps every channel x of its finished
+// 8-bit frame with a pow per fragment:
+//   B = clamp(2 * Brightness, 0.05, 2.99), g = 1.05 - 0.25 * B
+//   B <= 1: (B * x)^g
+//   B >  1: clamp(x * (1 + (1 - m) * (B - 1)))^g, m being the brightest channel
+// This renderer spreads x^g over the factors of the colour product, since
+// (a * b)^g = a^g * b^g: textures and light/fog maps get the power when they
+// are uploaded (ToneLUT, ToneLightLUT), vertex and tile colours when they are
+// batched (ToneColor), and the shader multiplies by the powers of its own
+// constants (uToneScale). What is left is a scale of the powered colour y:
+// B^g for B <= 1, exact, so the default Brightness 0.5 gives x^0.8. For B > 1
+// it is H(t) = (1 + (1 - t^(1/g)) * (B - 1))^g with t the brightest channel
+// of y, which the SF_ToneBoost shaders evaluate as a quadratic in t (a few
+// multiply-adds), fitted here by least squares of y * H over the 255 input
+// levels: within half a level for Brightness up to 1. No pow runs per
+// fragment on the Mali. Sums are approximated: fog maps, vertex fog and
+// distance fog in the shader (FOG_ADD, TONE_POW), the screen flash and
+// translucency by adding the powers (see ToneFog).
+//
+void UNOpenGLESRenderDevice::UpdateTone( FLOAT Brightness )
+{
+	guard(UNOpenGLESRenderDevice::UpdateTone);
+
+	ToneBrightness = Brightness;
+	const DOUBLE B = Clamp<DOUBLE>( Brightness * 2.0, 0.05, 2.99 );
+	const DOUBLE Gamma = 1.05 - 0.25 * B;
+	ToneBoostActive = ( B > 1.0 );
+	ToneBoost[0] = ToneBoost[1] = 0.f;
+	if( !ToneBoostActive )
+		ToneScale = (FLOAT)appPow( B, Gamma );
+	else
+	{
+		// y * (C0 + C1 * y + C2 * y^2) for a grey x (y = t = x^Gamma).
+		DOUBLE C[3];
+		FitTone( [B, Gamma]( DOUBLE X, DOUBLE Row[3], DOUBLE& Residual )
+		{
+			const DOUBLE Y = appPow( X, Gamma );
+			Row[0] = Y;
+			Row[1] = Y * Y;
+			Row[2] = Y * Y * Y;
+			Residual = appPow( Min<DOUBLE>( X * ( 1.0 + ( 1.0 - X ) * ( B - 1.0 ) ), 1.0 ), Gamma );
+		}, C );
+		ToneScale = (FLOAT)C[0];
+		ToneBoost[0] = (FLOAT)C[1];
+		ToneBoost[1] = (FLOAT)C[2];
+	}
+	// x^Gamma as x + x * (1 - x) * (C0 + C1 * x + C2 * x^2), for the distance
+	// fog amount (TONE_POW): within 3 levels at the default Gamma 0.8, the
+	// worst near x = 0.03, where x^Gamma is steepest.
+	{
+		DOUBLE C[3];
+		FitTone( [Gamma]( DOUBLE X, DOUBLE Row[3], DOUBLE& Residual )
+		{
+			const DOUBLE W = X * ( 1.0 - X );
+			Row[0] = W;
+			Row[1] = W * X;
+			Row[2] = W * X * X;
+			Residual = appPow( X, Gamma ) - X;
+		}, C );
+		for( INT i = 0; i < 3; i++ )
+			TonePow[i] = (FLOAT)C[i];
+	}
+
+	ToneGamma = (FLOAT)Gamma;
+	ToneModulatedScale = (FLOAT)appPow( 2.0, Gamma - 1.0 );
+	ToneTwo = (FLOAT)appPow( 2.0, Gamma );
+	// Light map texels t stand for 2 * t/255 (7 bits) times the overbright
+	// factor; ToneLightLUT clamps t at 127.5 first, as OpenGLDrv's light map
+	// shader does (min(LightColor, 0.5)), so bright dynamic lights saturate
+	// at the same level.
+	ToneLightMapScale = (FLOAT)appPow( 2.0 * ( Overbright ? LIGHTMAP_OVERBRIGHT : 1.0 ), Gamma );
+
+	UBOOL Changed = 0;
+	ToneIdentity = 1;
+	for( INT t = 0; t < 256; t++ )
+	{
+		const BYTE Color = (BYTE)appRound( 255.0 * appPow( t / 255.0, Gamma ) );
+		const BYTE Light = (BYTE)appRound( 255.0 * appPow( Min<DOUBLE>( t, 127.5 ) / 255.0, Gamma ) );
+		const BYTE FogAlpha = (BYTE)appRound( 255.0 * ( 1.0 - appPow( 1.0 - Min<DOUBLE>( 2.0 * t / 255.0, 1.0 ), Gamma ) ) );
+		Changed |= ( Color != ToneLUT[t] ) || ( Light != ToneLightLUT[t] ) || ( FogAlpha != ToneFogAlphaLUT[t] );
+		ToneLUT[t] = Color;
+		ToneLightLUT[t] = Light;
+		ToneFogAlphaLUT[t] = FogAlpha;
+		ToneIdentity &= ( Color == t );
+	}
+	for( INT i = 0; i <= 1024; i++ )
+		ToneColorLUT[i] = (FLOAT)appPow( i / 1024.0, Gamma );
